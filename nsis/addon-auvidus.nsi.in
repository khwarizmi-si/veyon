; Standalone installer for the Khwarizmi Auvidus add-on.
; Drops auvidus.dll (audio/webcam/USB device control) into an existing
; Khwarizmi installation.
!define ADDON_NAME "Auvidus"
!define ADDON_DLL "auvidus.dll"
!define ADDON_VERSION "1.0"
!define KH_ARCH "@VEYON_WINDOWS_ARCH@"
!define KH_SETREGVIEW "@VEYON_NSIS_SETREGVIEW@"
!include "nsis\addon-common.nsh"
